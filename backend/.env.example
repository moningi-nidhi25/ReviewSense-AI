# --- Database (SQLAlchemy → Supabase Postgres) ---
# Get this from Supabase > Project Settings > Database > Connection string (URI).
# Prefer the pooled connection (port 6543) for serverless hosting like Render.
# Format: postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend URL (used to redirect back after OAuth) ---
FRONTEND_URL=http://localhost:5173

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_DAYS=7
BCRYPT_ROUNDS=12

# Secret for Starlette's SessionMiddleware (required by Authlib for OAuth state)
SESSION_SECRET=change-me-to-another-long-random-string

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/15minute
RATE_LIMIT_REGISTER=5/15minute

# --- OAuth: Google ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {your-backend-url}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
# https://github.com/settings/developers
# Authorization callback URL: {your-backend-url}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ENV=development

# --- Legacy (only needed if you still use the supabase-py client elsewhere) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Future AI integration ---
GEMINI_API_KEY=
OPENAI_API_KEY=
